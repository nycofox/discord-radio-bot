DISCORD_TOKEN=YOUR_TOKEN_HERE

# Where to join
GUILD_ID=123456789012345678
VOICE_CHANNEL_ID=123456789012345678

# Radio stream URL (MP3/AAC/OGG - ffmpeg will decode)
STREAM_URL=https://your-station.example/stream

# Optional: how often (seconds) to refresh metadata presence
METADATA_PRESENCE_INTERVAL=20

# Optional: if you want to also post "Now playing" updates into a text channel
# NOWPLAYING_TEXT_CHANNEL_ID=123456789012345678
